# === Masamor Backend (NestJS) ===

# URL del proyecto Supabase (https://xxxx.supabase.co)
SUPABASE_URL=

# Secret key de Supabase (sb_secret_...) — SECRETO, nunca exponer al frontend.
# Reemplaza a la legacy service_role key. Salta RLS; se usa para validar el JWT.
# Settings > API Keys > Secret keys (crea una "default" si no existe).
SUPABASE_SECRET_KEY=

# Conexión directa a Postgres de Supabase (para Prisma).
# Supabase > Project Settings > Database > Connection string > URI
# Recomendado usar el pooler (puerto 6543) con ?pgbouncer=true para serverless,
# o la conexión directa (puerto 5432) para un servidor persistente como Render.
DATABASE_URL=

# URL del frontend, para CORS (ej: http://localhost:3000 en local)
FRONTEND_URL=http://localhost:3000

# Puerto del backend
PORT=3001

# === Emails transaccionales (Resend) ===
# API key de Resend. Si se deja vacía, los emails se omiten (se registran en log).
RESEND_API_KEY=
# Remitente. Para producción usa un dominio verificado en Resend.
# Para pruebas puedes usar: Masamor <onboarding@resend.dev>
RESEND_FROM=Masamor <onboarding@resend.dev>
