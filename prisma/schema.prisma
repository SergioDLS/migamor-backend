// Prisma se usa como query-builder tipado sobre la base gestionada por Supabase.
// La estructura real (enums, tablas, RLS, FKs a auth.users) vive en
// supabase/migration.sql — NO corras `prisma migrate` contra Supabase;
// aplica el SQL desde el editor de Supabase y usa `prisma generate` aquí.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  restaurant
  entrepreneur
  admin

  @@map("user_role")
}

enum OrderStatus {
  requested
  confirmed
  in_production
  shipped
  delivered
  cancelled

  @@map("order_status")
}

enum PriceTier {
  wholesale
  retail

  @@map("price_tier")
}

model Profile {
  id           String    @id @db.Uuid
  role         UserRole  @default(entrepreneur)
  businessName String?   @map("business_name")
  priceTier    PriceTier @default(retail) @map("price_tier")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  orders       Order[]

  @@map("profiles")
}

model Product {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  imageUrl    String?        @map("image_url")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  prices      ProductPrice[]
  orderItems  OrderItem[]

  @@map("products")
}

model ProductPrice {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  tier      PriceTier
  price     Decimal   @db.Decimal(12, 2)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tier])
  @@map("product_prices")
}

model Order {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  status             OrderStatus @default(requested)
  total              Decimal?    @db.Decimal(12, 2)
  notes              String?
  cancellationReason String?     @map("cancellation_reason")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   Profile     @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  history    OrderStatusHistory[]

  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
